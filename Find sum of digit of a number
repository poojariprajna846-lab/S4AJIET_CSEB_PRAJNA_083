class Main {
    public static void main(String[] args) {
        int n=1835;
        int lar=0;
        int sum=0;
        while(n!=0){
        int d=n%10;
        if(d>lar){
        lar=d;
        }
        sum=sum+d;
        n=n/10;
        }
        System.out.println("largest:"+lar);
        System.out.println("Sum of digits:"+sum);
    }
}
