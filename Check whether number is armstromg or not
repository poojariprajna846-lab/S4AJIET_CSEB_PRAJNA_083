class Main {
    public static void main(String[] args) {
        int n=153;
        int x=n;
        int arm=0;
        while(n!=0){
        int d=n%10;
        arm=arm+(d*d*d);
        n=n/10;
        }
        if(x==arm){
            System.out.println("Armstrong number");
            }else{
            System.out.println("Not Armstrong number");
            }
    }
}
