class Main {
    public static void main(String[] args) {
        int[] a = {10, 21, 30, 45, 50};
        int n = a.length;

        System.out.println("Even numbers:");

        for(int i = 0; i < n; i++) {

            if(a[i] % 2 == 0) {
                System.out.println(a[i]);
            }
        }

        System.out.println("Odd numbers:");

        for(int i = 0; i < n; i++) {

            if(a[i] % 2 != 0) {
                System.out.println(a[i]);
            }
        }
    }
}
